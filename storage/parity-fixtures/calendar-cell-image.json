{
  "_meta": {
    "purpose": "Shared ground truth for a photo placed on a calendar date. 'placements': how a cell entry's fit / rotation / blur / panX / panY are read (cell_image_placement in backend/django/services/calendar_renderer.py, cellImagePlacement in frontend/nextjs/src/lib/calendar.ts); absent or unreadable is the old behaviour (cover, no turn, no blur, centred). 'boxes': the box the photo is fitted into for a calendar block of width x height print px with that many week rows (cell_image_box / cellImageBox), which the date editor uses to draw its preview in the cell's own proportions.",
    "loaded_by": {
      "python": "backend/django/services/tests/test_calendar_cell_image.py",
      "typescript": "frontend/nextjs/src/lib/__tests__/calendar.parity.test.ts"
    }
  },
  "placements": [
    {
      "name": "nothing set is the old centre crop",
      "entry": {
        "type": "image",
        "uploadId": "u"
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "fit",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "fit": "contain"
      },
      "expected": {
        "fit": "contain",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "fit with blur",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "fit": "contain",
        "blur": true
      },
      "expected": {
        "fit": "contain",
        "rotation": 0,
        "blur": true,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "blur means nothing on a filled cell",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "fit": "cover",
        "blur": true
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "quarter turn",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": 90
      },
      "expected": {
        "fit": "cover",
        "rotation": 90,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "three quarter turns with fit",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": 270,
        "fit": "contain"
      },
      "expected": {
        "fit": "contain",
        "rotation": 270,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "a full turn is no turn",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": 360
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "turns past a full turn wrap",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": 450
      },
      "expected": {
        "fit": "cover",
        "rotation": 90,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "a negative turn wraps",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": -90
      },
      "expected": {
        "fit": "cover",
        "rotation": 270,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "not a quarter turn",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": 45
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "rotation as text is ignored",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": "90"
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "rotation as a boolean is ignored",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": true
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "unknown fit",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "fit": "stretch",
        "blur": true
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "blur must be a real true",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "fit": "contain",
        "blur": "yes"
      },
      "expected": {
        "fit": "contain",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "not an entry at all",
      "entry": null,
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "moved right and up",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "panX": 0.5,
        "panY": -0.25
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0.5,
        "panY": -0.25
      }
    },
    {
      "name": "moved fully left",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "panX": -1
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": -1,
        "panY": 0
      }
    },
    {
      "name": "a move past the edge stops at the edge",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "panX": 3,
        "panY": -7.5
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 1,
        "panY": -1
      }
    },
    {
      "name": "a move with a turn",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "rotation": 90,
        "panY": 1
      },
      "expected": {
        "fit": "cover",
        "rotation": 90,
        "blur": false,
        "panX": 0,
        "panY": 1
      }
    },
    {
      "name": "a whole photo has nowhere to move",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "fit": "contain",
        "panX": 0.5,
        "panY": 0.5
      },
      "expected": {
        "fit": "contain",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "a move as text is ignored",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "panX": "0.5",
        "panY": true
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    },
    {
      "name": "a move that is not a number is ignored",
      "entry": {
        "type": "image",
        "uploadId": "u",
        "panX": null,
        "panY": [
          1
        ]
      },
      "expected": {
        "fit": "cover",
        "rotation": 0,
        "blur": false,
        "panX": 0,
        "panY": 0
      }
    }
  ],
