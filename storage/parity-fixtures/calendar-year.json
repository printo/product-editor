{
  "_meta": {
    "purpose": "Shared ground truth for which year a calendar product covers: monthRange.defaultYear + calendarType + today -> base year and month labels. The print resolves it in backend/django/services/calendar_layout.py (resolve_default_year via materialize_surfaces, whose displayLabel names the ZIP files); the customer preview, leap-day toast and ops editor resolve it with resolveDefaultYear / yearOfMonth in frontend/nextjs/src/lib/calendar.ts. If either side drifts, the preview shows different months from the print and customer per-day entries land on dates the print never draws. 'today' is a date in IST. expectedFebruaryLabel is the February the product prints (the year the leap-day toast must check).",
    "loaded_by": {
      "python": "backend/django/services/tests/test_calendar_year_parity.py",
      "typescript": "frontend/nextjs/src/lib/__tests__/calendar.parity.test.ts"
    }
  },
  "cases": [
    {
      "name": "current_english_mid_year",
      "defaultYear": "current", "calendarType": "english", "today": "2026-05-21",
      "expectedBaseYear": 2026,
      "expectedFirstLabel": "January 2026", "expectedLastLabel": "December 2026",
      "expectedFebruaryLabel": "February 2026"
    },
    {
      "name": "current_financial_mid_year",
      "defaultYear": "current", "calendarType": "financial", "today": "2026-05-21",
      "expectedBaseYear": 2026,
      "expectedFirstLabel": "April 2026", "expectedLastLabel": "March 2027",
      "expectedFebruaryLabel": "February 2027"
    },
    {
