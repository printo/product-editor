{
  "name": "product-editor-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "clean": "rm -rf .next",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:parity": "jest --testPathPattern=\"calendar.parity|book-layout.parity\"",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "exifreader": "^4.54.0",
    "fabric": "^7.4.0",
    "framer-motion": "^11.18.2",
    "heic2any": "^0.0.4",
    "jose": "^6.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "^6.2.108",
    "pica": "^9.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "smartcrop": "^2.0.5"
  },
  "devDependencies": {
    "@happy-dom/jest-environment": "^20.14.6",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jszip": "^3.4.0",
    "@types/node": "25.4.0",
    "@types/pica": "^9.0.5",
    "@types/react": "19.2.14",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks": "7.1.1"
    }
  }
}
