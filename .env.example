# ============================================
# Product Editor — Environment Configuration
# ============================================
#
# SETUP:
#   1. cp .env.example .env
#   2. Replace every <CHANGE_THIS...> placeholder.
#   3. Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
#   4. Never commit .env — it's gitignored on purpose. This file (.env.example)
#      is the only one meant to be shared/reviewed.
#
# Local vs. production: these are NEVER meant to hold the same values. Ports
# differ (local avoids clashing with other projects on the same machine),
# and secrets differ deliberately (a leak on one side must not compromise
# the other). Fill in each environment's own copy independently — don't
# copy one over the other.
# ============================================

# Enable production profile (nginx edge proxy). Leave unset for local dev.
COMPOSE_PROFILES=prod
NODE_ENV=production

# ===============================
# Django Settings
# ===============================
DEBUG=0
# Django's OWN internal cryptographic key — unrelated to the API keys
# below. Signs session cookies, CSRF tokens, and password-reset tokens for
# the Django admin. Every Django app needs one of these regardless of how
# many API keys it has; it answers a completely different question ("is
# this cookie/token genuine") than "which partner is calling."
# REQUIRED IN PRODUCTION — Django refuses to boot under DEBUG=0 with the
# dev default below.
DJANGO_SECRET_KEY=<CHANGE_THIS_GENERATE_NEW_SECRET>

# nginx (the edge proxy) already redirects HTTP→HTTPS — Django doesn't need to.
SECURE_SSL_REDIRECT=False

# Your production domain(s), comma-separated, no scheme.
ALLOWED_HOSTS=yourdomain.com,backend

# Only the production domain(s) that actually call the API, comma-separated,
# with scheme.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Set to False once the django-csp policy has been validated against the
# editor (Fabric.js needs 'unsafe-eval') and the embed iframe. Defaults to
# report-only: headers are emitted, nothing is blocked.
CSP_REPORT_ONLY=True

# ===============================
# Database
# ===============================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
# IMPORTANT: use a strong password. This is a real credential, not a
# placeholder to leave as-is.
POSTGRES_PASSWORD=<CHANGE_THIS_STRONG_PASSWORD>
POSTGRES_DB=product_editor

# ===============================
# Redis
# ===============================
# Celery broker lives on db 0. The Django cache is auto-derived by swapping
# the trailing /0 for /1 unless REDIS_CACHE_URL is set explicitly — same
# Redis instance, separate logical DBs, so the cache's eviction policy can't
# drop in-flight Celery messages.
REDIS_URL=redis://redis:6379/0

# ===============================
# API Keys — "which caller is this, and what can it do"
# ===============================
# Three SEPARATE credentials, not three copies of the same thing. Each is
# its own row in the APIKey table (entrypoint.sh seeds/updates all three
# from these env vars on every boot) with its own scope and rate limit.
# This is a different question from the secrets under Authentication &
# Tokens below (those answer "is this cookie/token/handoff genuine").
#   DIRECT   - the ops team's own key, for direct partner-API use.
#              is_ops_team=True, 10,000 req/day. INTERNAL_API_KEY below is
#              a separate, independent credential with the same
#              is_ops_team=True access — for the internal dashboard/editor
#              proxy specifically, not for direct API calls.
#   EXTERNAL - an actual partner's key. is_ops_team=False, 1,000 req/day.
#   TESTING  - isolated key for smoke tests, so tests never need to know a
#              real partner's key. is_ops_team=False, 5,000 req/day.
# Generate a unique value for each, per environment.
# Format: editor_<env>_sk_<random_string>
DIRECT_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
EXTERNAL_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
TESTING_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>

# REQUIRED IN PRODUCTION. The api_key the Next.js internal proxy sends to
# Django for every dashboard/editor request. Server-side only (NOT a
# NEXT_PUBLIC_ var) — the proxy 500s loudly if it is unset.
#
# Its own independent value — generate a NEW one, don't reuse DIRECT_API_KEY.
# entrypoint.sh seeds a dedicated is_ops_team=True "INTERNAL" row from this
# (mirrors DIRECT's access, since the proxy needs the same /ops/* reach), so
# dashboard traffic gets its own audit trail and can be rotated without
# touching DIRECT. If this still holds an old value equal to DIRECT_API_KEY
# (from before this was split), entrypoint.sh logs a warning and skips
# seeding that boot — dashboard traffic keeps working via the DIRECT row in
# the meantime, so there's no rush; generate a unique value when convenient.
INTERNAL_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>

# ===============================
# Authentication & Tokens — "is this cookie/token/handoff genuine"
# ===============================
# Signs the frontend's NextAuth session JWT — a different purpose and a
# different value from DJANGO_SECRET_KEY above (that one secures Django's
# own internals; this one secures the Next.js login session).
# REQUIRED IN PRODUCTION — docker-compose aborts the deploy if this is unset.
AUTH_SECRET=<CHANGE_THIS_GENERATE_NEW_SECRET>

# A fourth kind of credential, distinct from the three API keys above —
# those say WHO is calling; this says whether one specific internal handoff
# can be trusted. REQUIRED IN PRODUCTION. Shared secret that gates the embed
# session-validate endpoint (GET /api/embed/session/validate), which returns
# a partner's real api_key. The Next.js embed proxy sends it as
# X-Internal-Secret; Django refuses to serve the api_key in production
# (DEBUG=0) if it is unset.
# Leave blank in local dev (DEBUG=1) to keep the embed flow working on localhost.
EMBED_INTERNAL_SECRET=<CHANGE_THIS_GENERATE_NEW_SECRET>

# ===============================
# NextAuth
# ===============================
# Required. Read directly by the next-auth package itself (its own env-var
# convention) — neither name below appears in this repo's own source, which
# is expected, not a sign they're unused. Your production domain, no
# trailing slash.
AUTH_URL=https://yourdomain.com
# Trust the reverse proxy's Host/X-Forwarded-* headers. Always true in this
# setup (nginx sits in front everywhere) — override only if you ever run
# without a proxy in front.
AUTH_TRUST_HOST=true

# Google Sign-In (GIS button on the login page). PUBLIC client ID — safe to
# expose to the browser. Because it is a NEXT_PUBLIC_* var it is inlined at
# BUILD time, so it must be present before `pnpm build` (the login page also
# falls back to printo.in's client ID if unset). The matching PIA endpoint is
# POST {PIA_API_BASE_URL}/auth/google/login/  body {"id_token": "<jwt>"}.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=875434468582-2a7h0gahc6sq6jm3gfmre9cca1lhh0p7.apps.googleusercontent.com

# ===============================
# Docker / Edge proxy (nginx) / Ports
# ===============================
# Hostname nginx accepts; also the CN of the bootstrap self-signed cert when
# proxy/nginx/certs/origin.crt is missing. For production, paste a Cloudflare
# Origin Certificate into proxy/nginx/certs/origin.{crt,key} — see
# proxy/nginx/README.md.
PUBLIC_HOST=yourdomain.com
# /api is routed to the Django backend by nginx (see proxy/nginx/nginx.conf).
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_HOST_PORT=5004
# Host port for the backend container (loopback-bound). Override if 8000 is taken.
BACKEND_HOST_PORT=8000

# ===============================
# External Services
# ===============================
PIA_API_BASE_URL=https://pia.printo.in/api/v1

# ===============================
# Storage & Retention
# ===============================
# EXPORTS_DIR / UPLOADS_DIR / LAYOUTS_DIR are NOT env vars — settings.py
# derives them from STORAGE_ROOT.
STORAGE_ROOT=/app/storage

# Single source of truth for max per-file upload size — read by Django
# settings, validators, and chunked-upload init endpoint.
MAX_UPLOAD_FILE_SIZE_MB=50

# How long a render's output files and the customer's uploaded originals are
# kept before garbage_collector_task deletes them. SINGLE SOURCE OF TRUTH — it
# drives both the expires_at sent in the completion webhook and the retention
# the GC enforces, so the promise cannot drift from the behaviour.
#
# After this many days the customer's photos AND their print files are gone:
# a reprint request past the window has nothing left to serve. Raise it if
# support regularly needs to re-issue downloads.
EXPORT_RETENTION_DAYS=7
# Retention when EXPORTS_DIR passes 80% full. Defaults to the same value, so
# expires_at stays accurate even under disk pressure. Set lower to trade that
# guarantee for headroom.
# EXPORT_RETENTION_DAYS_UNDER_PRESSURE=7

# Age at which the last GC sweep is reported as stale on /api/celery/monitor/
# (`garbage_collector.stale`). 36h so a run that is merely late does not cry
# wolf, but a single missed night does. Alert on that field — the GC stopping
# silently is what filled the prod disk to 89% for a week.
# GC_STALE_AFTER_HOURS=36

# Max allowed image side (px) at upload validation. This is a 300-DPI print-file
# generator, so high-res camera/phone photos (48–65 MP routinely exceed 8192px)
# are desirable input. The render engine caps total pixels (Image.MAX_IMAGE_PIXELS
# = 500 MP) and smart-downscales sources, so this is a decompression-bomb guard,
# not a quality limit. 16384 covers ~200 MP long-edge sensors (16384² = 268 MP).
MAX_IMAGE_DIMENSION_PX=16384

# ===============================
# Celery / Async Queue
# ===============================
# CELERY_CONCURRENCY is unset by default — Celery auto-detects from CPU
# count per worker replica. docker-compose passes .env to workers via
# env_file, so a value set here IS binding. Uncomment only to cap on
# shared / many-core hosts.
# CELERY_CONCURRENCY=2

# ===============================
# Gunicorn (Optional)
# ===============================
# Leave blank to auto-scale to (2 x cores + 1) — entrypoint.sh computes this
# from nproc. Only set a fixed number to cap it on a shared box; a stale
# fixed number here previously undercounted a 2-core box's real default (5).
GUNICORN_WORKERS=
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600
# Requests per web worker before graceful recycle. Web workers do light I/O
# only (heavy Pillow rendering runs in Celery), so a higher ceiling is safe and
# recycles workers far less often — shrinking the transient-502 window during
# large-quantity bulk uploads. Pairs with the chunked-upload retry in
# upload-utils.ts.
GUNICORN_MAX_REQUESTS=2000
GUNICORN_LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────
# Auto-orientation detection mode (server-side MediaPipe Pose Landmarker).
#
# Decides how the editor handles photos whose subject is stored sideways
# in the file bytes (camera held wrong / scan of a printed photo / etc.
# where EXIF orientation says "normal" so the browser has no rotation
# hint). The chosen model runs on the Django backend; the customer's
# device never downloads ML — consistent quality regardless of browser
# speed.
#
# Uncomment EXACTLY ONE line. Switching modes requires only a backend
# restart (`docker compose restart backend`), not a full rebuild.
#
# ─── Option 1: mediapipe ─ Recommended for ≤ 2 cores
# BlazePose Lite model (~5 MB resident, ~30-50 ms per photo on CPU).
# Covers ~90% of photos with a visible person; falls back to the
# aspect-ratio heuristic when no pose is detected (food / landscape).
AUTO_ORIENTATION_MODE=mediapipe
#
# ─── Option 2: hybrid ─ Recommended for ≥ 4 cores
# BlazePose Full model (~9 MB resident, ~80-150 ms per photo on CPU).
# More accurate on partial bodies / profile faces / unusual poses.
# Same code path — only the model variant in memory changes.
# AUTO_ORIENTATION_MODE=hybrid
#
# ─── Option 3: off ─ Disable ML entirely
# Uses only the aspect-ratio heuristic in editor/layout/[name]/page.tsx.
# The /api/orientation/detect endpoint returns 503; frontend skips it.
# Useful for A/B testing or troubleshooting.
# AUTO_ORIENTATION_MODE=off
# ─────────────────────────────────────────────────────────────────────────

# ===============================
# Observability — Sentry (error tracking)
# ===============================
# Sentry DSN (Settings -> Client Keys (DSN) in the Sentry project). Leave
# blank to keep Sentry disabled — backend and frontend both no-op without it.
# Turning this on is a deliberate choice, not something to fill in just
# because it's listed here: only browser-side JS errors are captured (no
# server-side Next.js coverage, no source maps), and it costs real Sentry
# quota once traffic is non-trivial.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Set to "0" to stop Sentry attaching request PII (IP, headers, etc.) to
# events. Defaults off — flip on only if you've reviewed what that means
# against the DPDP erasure guarantees elsewhere in this app (Sentry's cloud
# can't be reached by OrderDataPurgeView).
SENTRY_SEND_DEFAULT_PII=0

# ===============================
# Observability — Grafana OSS (Loki logs + Alloy/Faro RUM)
# ===============================
# All optional — the app runs fine with none of this set. Only takes effect
# once you run `docker compose --profile monitoring up -d`.
GRAFANA_ADMIN_PASSWORD=admin-secret-password
# The real public https://<host>/grafana/ — Grafana needs this to generate
# correct OAuth redirect/asset URLs. The docker-compose default is a
# localhost fallback for local dev only; prod must set this explicitly.
GRAFANA_ROOT_URL=
# Printo Google login for Grafana (@printo.in only). Off until this is
# "true" — a half-configured client can't lock everyone out. The admin
# account above stays as a break-glass fallback either way.
GF_AUTH_GOOGLE_ENABLED=false
# Non-secret; defaults in docker-compose.yml to the same client
# NEXT_PUBLIC_GOOGLE_CLIENT_ID above already uses. Only override if you want
# Grafana on a separate OAuth client.
GF_AUTH_GOOGLE_CLIENT_ID=
# Cloud Console -> Credentials -> the client above -> add
# https://<host>/grafana/login/google as an authorized redirect URI -> copy
# its secret here. Never commit this, never paste it anywhere but .env.
GF_AUTH_GOOGLE_CLIENT_SECRET=

# The real public https://<host>/faro/collect — proxied by nginx to the
# alloy service (monitoring/alloy/config.alloy), which forwards into loki.
# Reachable from customer browsers by design (RUM payloads aren't
# request-authenticated, same as any RUM collector). A localhost value
# never works for a real visitor — "localhost" from their browser means
# their own machine, not the server.
NEXT_PUBLIC_FARO_URL=https://yourdomain.com/faro/collect

# Google Chat webhook for deploy alerts (scripts/setup-observability.sh).
# Chat space -> Apps & integrations -> Webhooks. This URL IS the credential
# (key+token live in it) — never hardcode it in a script, never paste it
# anywhere outside this file.
GOOGLE_CHAT_WEBHOOK=
