# Product Editor — Environment Configuration
# Copy to .env and replace every <CHANGE_THIS...> placeholder.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Never commit .env — it's gitignored. This file is for version control only.

NODE_ENV=production
DEBUG=0

# Django settings
DJANGO_SECRET_KEY=<CHANGE_THIS_GENERATE_NEW_SECRET>
SECURE_SSL_REDIRECT=False
ALLOWED_HOSTS=yourdomain.com,backend
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSP_REPORT_ONLY=True

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_THIS_STRONG_PASSWORD>
POSTGRES_DB=product_editor
# Persistent connection age in seconds. Set to 0 if PgBouncer is ever put in front.
DB_CONN_MAX_AGE=600

# Redis (db 0 = Celery broker, db 1 = Django cache auto-derived)
REDIS_URL=redis://redis:6379/0

# API Keys — DIRECT (ops), EXTERNAL (partner), TESTING (smoke tests), INTERNAL (proxy)
# See CLAUDE.md for what makes each different.
DIRECT_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
EXTERNAL_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
TESTING_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
INTERNAL_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>

# Authentication & Tokens
AUTH_SECRET=<CHANGE_THIS_GENERATE_NEW_SECRET>
EMBED_INTERNAL_SECRET=<CHANGE_THIS_GENERATE_NEW_SECRET>

# NextAuth
AUTH_URL=https://yourdomain.com
AUTH_TRUST_HOST=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=875434468582-2a7h0gahc6sq6jm3gfmre9cca1lhh0p7.apps.googleusercontent.com

# Docker / nginx / Ports
PUBLIC_HOST=yourdomain.com
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_HOST_PORT=5004
BACKEND_HOST_PORT=8000

# External Services
PIA_API_BASE_URL=https://pia.printo.in/api/v1

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage
MAX_UPLOAD_FILE_SIZE_MB=50
EXPORT_RETENTION_DAYS=7
MAX_IMAGE_DIMENSION_PX=16384
# Shorter retention while the disk is under pressure. Left unset on purpose:
# it defaults to EXPORT_RETENTION_DAYS, which keeps the expires_at we send
# partners in the webhook always accurate. Set it LOWER than the line above
# only if you need the disk valve back, accepting a best-effort expires_at.
#EXPORT_RETENTION_DAYS_UNDER_PRESSURE=3

# S3 Configuration (only needed if STORAGE_BACKEND=s3)
S3_BUCKET=pia-oms-uploads
S3_PREFIX=product-editor
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<CHANGE_THIS_IF_USING_S3>
AWS_SECRET_ACCESS_KEY=<CHANGE_THIS_IF_USING_S3>
S3_CDN_DOMAIN=cdn-product-editor.printo.in

# Garbage collection & audit retention (all have safe defaults — these ARE them)
# Reclaim export dirs no DB row accounts for: off | dry_run | delete.
# Defaults to reporting only; it is the one sweep that deletes on the ABSENCE
# of evidence, so read a few nights of garbage_collector.stats.orphan_exports
# on /api/celery/monitor/ before arming it.
GC_ORPHAN_SWEEP=dry_run
# Age at which the last sweep reports `stale` on /api/celery/monitor/.
GC_STALE_AFTER_HOURS=36
# Age at which an abandoned .chunks/<uuid>/ upload staging dir is reclaimed.
CHUNK_STAGING_MAX_AGE_HOURS=24
# APIRequest audit rows. Deliberately far longer than EXPORT_RETENTION_DAYS —
# the trail has to outlive the data it describes to answer "who touched this".
API_AUDIT_RETENTION_DAYS=90

# Celery / Gunicorn (auto-scales by default)
# Caps Celery worker slots. Commented out, NOT blank, on purpose: an empty
# value is not an unset one — api/tasks.py does int(os.getenv(...)), so
# `CELERY_CONCURRENCY=` crashes the backend on import. Unset means Celery
# auto-detects from CPU count; set a number only to cap a shared box.
#CELERY_CONCURRENCY=2
GUNICORN_WORKERS=
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600
GUNICORN_MAX_REQUESTS=2000
GUNICORN_LOG_LEVEL=info

# Auto-orientation (mediapipe | hybrid | off)
AUTO_ORIENTATION_MODE=mediapipe

# Observability — Sentry (leave blank to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=0
# Performance-trace sampling. 1.0 traces every transaction — lower it if
# Sentry volume becomes a cost. Only read when SENTRY_DSN is set.
SENTRY_TRACES_SAMPLE_RATE=1.0
