# Product Editor — Environment Configuration
# Copy to .env and replace every <CHANGE_THIS...> placeholder.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Never commit .env — it's gitignored. This file is for version control only.

COMPOSE_PROFILES=prod
NODE_ENV=production
DEBUG=0

# Django settings
DJANGO_SECRET_KEY=<CHANGE_THIS_GENERATE_NEW_SECRET>
SECURE_SSL_REDIRECT=False
ALLOWED_HOSTS=yourdomain.com,backend
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSP_REPORT_ONLY=True

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_THIS_STRONG_PASSWORD>
POSTGRES_DB=product_editor

# Redis (db 0 = Celery broker, db 1 = Django cache auto-derived)
REDIS_URL=redis://redis:6379/0

# API Keys — DIRECT (ops), EXTERNAL (partner), TESTING (smoke tests), INTERNAL (proxy)
# See CLAUDE.md for what makes each different.
DIRECT_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
EXTERNAL_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
TESTING_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
INTERNAL_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>

# Authentication & Tokens
AUTH_SECRET=<CHANGE_THIS_GENERATE_NEW_SECRET>
EMBED_INTERNAL_SECRET=<CHANGE_THIS_GENERATE_NEW_SECRET>

# NextAuth
AUTH_URL=https://yourdomain.com
AUTH_TRUST_HOST=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=875434468582-2a7h0gahc6sq6jm3gfmre9cca1lhh0p7.apps.googleusercontent.com

# Docker / nginx / Ports
PUBLIC_HOST=yourdomain.com
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_HOST_PORT=5004
BACKEND_HOST_PORT=8000

# External Services
PIA_API_BASE_URL=https://pia.printo.in/api/v1

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage
MAX_UPLOAD_FILE_SIZE_MB=50
EXPORT_RETENTION_DAYS=7
MAX_IMAGE_DIMENSION_PX=16384

# S3 Configuration (only needed if STORAGE_BACKEND=s3)
S3_BUCKET=pia-oms-uploads
S3_PREFIX=product-editor
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<CHANGE_THIS_IF_USING_S3>
AWS_SECRET_ACCESS_KEY=<CHANGE_THIS_IF_USING_S3>
S3_CDN_DOMAIN=cdn-product-editor.printo.in

# Celery / Gunicorn (auto-scales by default)
GUNICORN_WORKERS=
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600
GUNICORN_MAX_REQUESTS=2000
GUNICORN_LOG_LEVEL=info

# Auto-orientation (mediapipe | hybrid | off)
AUTO_ORIENTATION_MODE=mediapipe

# Observability — Sentry (leave blank to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=0

# Observability — Grafana (optional, enable via --profile monitoring)
GRAFANA_ADMIN_PASSWORD=admin-secret-password
GRAFANA_ROOT_URL=
GF_AUTH_GOOGLE_ENABLED=false
GF_AUTH_GOOGLE_CLIENT_ID=
GF_AUTH_GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_FARO_URL=https://yourdomain.com/faro/collect
GOOGLE_CHAT_WEBHOOK=
