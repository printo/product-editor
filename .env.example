# ============================================
# Product Editor - Environment Configuration
# ============================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Update all values marked with <CHANGE_THIS>
# 3. Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(50))"
# 4. Never commit .env to git!
#
# ============================================

# Enable production profile (nginx edge proxy)
COMPOSE_PROFILES=prod

# ===============================
# Server / General Configuration
# ===============================
NODE_ENV=production

# ===============================
# Django Settings
# ===============================
DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<CHANGE_THIS_GENERATE_NEW_SECRET>

# nginx (the edge proxy) already redirects HTTP→HTTPS — Django doesn't need to
SECURE_SSL_REDIRECT=False

# Your production domain (comma-separated)
ALLOWED_HOSTS=yourdomain.com,backend

# CORS - Only production domains (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ===============================
# Database Configuration
# ===============================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
# IMPORTANT: Use a strong password!
POSTGRES_PASSWORD=<CHANGE_THIS_STRONG_PASSWORD>
POSTGRES_DB=product_editor

# Connection Pool Settings

# ===============================
# API Keys Configuration
# ===============================
# Generate unique keys for each environment
# Format: editor_<env>_sk_<random_string>
DIRECT_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
EXTERNAL_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>
TESTING_API_KEY=<CHANGE_THIS_GENERATE_NEW_API_KEY>

# REQUIRED IN PRODUCTION. The api_key the Next.js internal proxy sends to
# Django for every dashboard/editor request. Server-side only (NOT a
# NEXT_PUBLIC_ var) — the proxy 500s loudly if it is unset. Both containers
# read it via env_file.
#
# *** SET THIS TO EXACTLY THE SAME VALUE AS DIRECT_API_KEY ABOVE. ***
# entrypoint.sh seeds the DIRECT / EXTERNAL / TESTING APIKey rows from those
# env vars on every web boot, and only DIRECT is ops-flagged. A separately
# generated key matches no APIKey row at all, so every dashboard and template
# call comes back 403 ("Failed to load layouts") — and even a valid non-DIRECT
# key would fail on /ops/* because Django's IsOpsTeam inspects this service
# account, not the logged-in human. Reusing DIRECT_API_KEY also survives DB
# restores, because the entrypoint re-seeds that row from env each boot.
INTERNAL_API_KEY=<SAME_VALUE_AS_DIRECT_API_KEY_ABOVE>

# ===============================
# Storage
# ===============================

# ===============================
# Authentication & Tokens
# ===============================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# REQUIRED IN PRODUCTION — docker-compose aborts the deploy if AUTH_SECRET is
# unset (no baked default), and Django refuses to boot with a default
# DJANGO_SECRET_KEY under DEBUG=0.
AUTH_SECRET=<CHANGE_THIS_GENERATE_NEW_SECRET>
DJANGO_SECRET_KEY=<CHANGE_THIS_GENERATE_NEW_SECRET>

# REQUIRED IN PRODUCTION. Shared secret that gates the embed session-validate
# endpoint (GET /api/embed/session/validate), which returns a partner's real
# api_key. The Next.js embed proxy sends it as X-Internal-Secret; Django refuses
# to serve the api_key in production (DEBUG=0) if it is unset. Both the backend
# and frontend containers read it from this .env via env_file, so set it ONCE.
# Leave blank in local dev (DEBUG=1) to keep the embed flow working on localhost.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
EMBED_INTERNAL_SECRET=<CHANGE_THIS_GENERATE_NEW_SECRET>

# ===============================
# Rate Limiting & Worker
# ===============================
# Single source of truth for max per-file upload size — read by Django settings,
# validators, and chunked-upload init endpoint.
MAX_UPLOAD_FILE_SIZE_MB=50

# How long a render's output files and the customer's uploaded originals are
# kept before garbage_collector_task deletes them. SINGLE SOURCE OF TRUTH — it
# drives both the expires_at sent in the completion webhook and the retention
# the GC enforces, so the promise cannot drift from the behaviour.
#
# After this many days the customer's photos AND their print files are gone:
# a reprint request past the window has nothing left to serve. Raise it if
# support regularly needs to re-issue downloads.
EXPORT_RETENTION_DAYS=7
# Retention when EXPORTS_DIR passes 80% full. Defaults to the same value, so
# expires_at stays accurate even under disk pressure. Set lower to trade that
# guarantee for headroom.
# EXPORT_RETENTION_DAYS_UNDER_PRESSURE=7
# Max allowed image side (px) at upload validation. This is a 300-DPI print-file
# generator, so high-res camera/phone photos (48–65 MP routinely exceed 8192px)
# are desirable input. The render engine caps total pixels (Image.MAX_IMAGE_PIXELS
# = 500 MP) and smart-downscales sources, so this is a decompression-bomb guard,
# not a quality limit. 16384 covers ~200 MP long-edge sensors (16384² = 268 MP).
MAX_IMAGE_DIMENSION_PX=16384

# ─────────────────────────────────────────────────────────────────────────
# Auto-orientation detection mode (server-side MediaPipe Pose Landmarker).
#
# Decides how the editor handles photos whose subject is stored sideways
# in the file bytes (camera held wrong / scan of a printed photo / etc.
# where EXIF orientation says "normal" so the browser has no rotation
# hint). The chosen model runs on the Django backend; the customer's
# device never downloads ML — consistent quality regardless of browser
# speed.
#
# Uncomment EXACTLY ONE line. Switching modes requires only a backend
# restart (`docker compose restart backend`), not a full rebuild.
#
# ─── Option 1: mediapipe ─ Recommended for ≤ 2 cores
# BlazePose Lite model (~5 MB resident, ~30-50 ms per photo on CPU).
# Covers ~90% of photos with a visible person; falls back to the
# aspect-ratio heuristic when no pose is detected (food / landscape).
AUTO_ORIENTATION_MODE=mediapipe
#
# ─── Option 2: hybrid ─ Recommended for ≥ 4 cores
# BlazePose Full model (~9 MB resident, ~80-150 ms per photo on CPU).
# More accurate on partial bodies / profile faces / unusual poses.
# Same code path — only the model variant in memory changes.
# AUTO_ORIENTATION_MODE=hybrid
#
# ─── Option 3: off ─ Disable ML entirely
# Uses only the aspect-ratio heuristic in editor/layout/[name]/page.tsx.
# The /api/orientation/detect endpoint returns 503; frontend skips it.
# Useful for A/B testing or troubleshooting.
# AUTO_ORIENTATION_MODE=off
# ─────────────────────────────────────────────────────────────────────────

# ===============================
# Frontend Configuration
# ===============================
# /api is routed to the Django backend by nginx (see proxy/nginx/nginx.conf)
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_HOST_PORT=5004
# Host port for the backend container (loopback-bound). Override if 8000 is taken.
BACKEND_HOST_PORT=8000

# ===============================
# NextAuth Configuration
# ===============================
# Your production domain
AUTH_URL=https://yourdomain.com
AUTH_TRUST_HOST=true

# Google Sign-In (GIS button on the login page). PUBLIC client ID — safe to
# expose to the browser. Because it is a NEXT_PUBLIC_* var it is inlined at
# BUILD time, so it must be present before `pnpm build` (the login page also
# falls back to printo.in's client ID if unset). The matching PIA endpoint is
# POST {PIA_API_BASE_URL}/auth/google/login/  body {"id_token": "<jwt>"}.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=875434468582-2a7h0gahc6sq6jm3gfmre9cca1lhh0p7.apps.googleusercontent.com

# ===============================
# Docker / Edge proxy (nginx)
# ===============================
# Hostname nginx accepts; also the CN of the bootstrap self-signed cert when
# proxy/nginx/certs/origin.crt is missing. For production, paste a Cloudflare
# Origin Certificate into proxy/nginx/certs/origin.{crt,key} — see
# proxy/nginx/README.md for the workflow.
PUBLIC_HOST=yourdomain.com
# Set to False once the django-csp policy has been validated; defaults to report-only
CSP_REPORT_ONLY=True

# ===============================
# External Services
# ===============================
PIA_API_BASE_URL=https://pia.printo.in/api/v1

# ===============================
# Redis Configuration
# ===============================
REDIS_URL=redis://redis:6379/0

# ===============================
# Celery / Async Queue
# ===============================
# Worker slots per container (keep at 2 unless you raise memory limit proportionally)
# CELERY_CONCURRENCY is unset by default — Celery auto-detects from CPU
# count per worker replica. docker-compose passes .env to workers via
# env_file, so a value set here IS binding. Uncomment only to cap on
# shared / many-core hosts.
# CELERY_CONCURRENCY=2

# ===============================
# Storage (Render Outputs)
# ===============================
# EXPORTS_DIR / UPLOADS_DIR / LAYOUTS_DIR are NOT env vars — settings.py derives
# them from STORAGE_ROOT. Listing EXPORTS_DIR here made it show up as "missing
# from production" on every env-drift diff, for a name nothing reads.
STORAGE_ROOT=/app/storage

# ===============================
# Gunicorn Configuration (Optional)
# ===============================
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
# Requests per web worker before graceful recycle. Web workers do light I/O
# only (heavy Pillow rendering runs in Celery), so a higher ceiling is safe and
# recycles workers far less often — shrinking the transient-502 window during
# large-quantity bulk uploads. Pairs with the chunked-upload retry in
# upload-utils.ts.
GUNICORN_MAX_REQUESTS=2000
GUNICORN_LOG_LEVEL=info

# ===============================
# Observability Configuration
# ===============================
# Printo Sentry Account DSN (Project: product-editor)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345

# Self-Hosted Grafana OSS (Loki + Faro RUM)
GRAFANA_ADMIN_PASSWORD=admin-secret-password
NEXT_PUBLIC_FARO_URL=http://localhost:3001/faro/receiver

